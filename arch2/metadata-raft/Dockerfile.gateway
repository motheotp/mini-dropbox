FROM python:3.9-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir flask==2.3.0

# Copy proto files and generate code
COPY metadata.proto .
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. metadata.proto

# Copy gateway code
COPY metadata_http_gateway.py .

CMD ["python", "-u", "metadata_http_gateway.py"]